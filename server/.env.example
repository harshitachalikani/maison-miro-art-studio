# Required backend environment variables.
# Copy to .env and enter values privately. Never commit .env.
# The frontend has no Vite environment variables; its API URL is configured in src/api.js.

# PostgreSQL connection string from the database project you intend to use.
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE
DATABASE_URL=postgresql://your_user:your_password@your_host:5432/your_database

# Required secret used to sign and verify JWT tokens. Generate privately, for example:
# openssl rand -hex 64
JWT_SECRET=replace_with_a_long_random_secret_string
